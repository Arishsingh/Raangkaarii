# Copy to .env.local and fill in. Never commit a filled-in copy — .env* is
# gitignored, and every value here is a live credential in production.

# --- Auth.js (NextAuth) ---
# Signs and encrypts the session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-here

# Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client
# ID -> Web application. Add both redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-domain>/api/auth/callback/google
# Leave both blank to run the shop with email + password only; the sign-in page
# hides the Google button rather than offering one that cannot work.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Database (Neon Postgres) ---
# Neon -> Connection string (pooled). Holds the catalogue, orders and accounts.
DATABASE_URL=your-existing-database-url

# --- Storage, payments, shipping, assistant ---
BLOB_READ_WRITE_TOKEN=vercel-blob-read-write-token
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=razorpay-webhook-secret
DELHIVERY_API_KEY=delhivery-api-token
DELHIVERY_PICKUP_NAME=registered-pickup-location-name
GEMINI_API_KEY=google-ai-studio-key

# Comma-separated admin allowlist. Falls back to the built-in list in
# src/lib/admin.ts when unset.
ADMIN_EMAILS=owner@example.com
